# Database Configuration
# For SQLite (default): sqlite:///./securezim.db
# For PostgreSQL: postgresql://user:password@localhost/securezim
# For MySQL: mysql://user:password@localhost/securezim
DATABASE_URL=sqlite:///./securezim.db

# JWT Secret Key
# Generate a strong secret key in production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
DEBUG=False
